---
import LayoutProyecto from "../../../layouts/LayoutProyecto.astro";
---

<LayoutProyecto title="Día 52" subtitle="Generador de QR">
  <div class="container dia52">
    <section class="box">
      <form id="formQR">
        <input
          type="text"
          id="inputURL"
          placeholder="https://ejemplo.com"
          autocomplete="off"
          spellcheck="false"
        />
        <p id="error" class="error hide">Ingresa un enlace para generar el QR</p>
        <button type="submit" class="btn">Generar QR</button>
      </form>

      <div id="resultado" class="resultado hide">
        <div id="preview" class="preview"></div>
        <div class="buttons-actions">
          <button id="btnSVG" class="btn">Descargar SVG</button>
          <button id="btnPNG" class="btn2">Descargar PNG</button>
        </div>
      </div>
    </section>
  </div>
</LayoutProyecto>

<style>
  .dia52 {
    min-height: 70vh;
    display: grid;
    place-content: center;
    background-color: var(--celeste-claro);
  }

  .box {
    background-color: #f8fafc;
    border-radius: 12px;
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.1),
      0 6px 6px rgba(0, 0, 0, 0.1);
    padding: 1.5rem;
    width: 400px;
    max-width: 90vw;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  input {
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 2px solid var(--celeste-claro);
    outline: none;
    font-size: 1rem;
    color: var(--text-color);
    transition: border-color 0.2s ease-in-out;

    &:focus {
      border-color: var(--celeste-oscuro);
    }
  }

  .error {
    color: #e5484d;
    font-size: 0.875rem;
    text-align: center;
  }

  .btn2 {
    background-color: var(--naranja-claro);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    color: #fff;
    font-weight: bold;
    box-shadow: 0 3px 3px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out;

    &:hover {
      transform: scale(1.02);
    }

    &:active {
      transform: scale(0.99);
    }
  }

  .btn {
    background-color: var(--celeste-oscuro);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    color: #fff;
    font-weight: bold;
    box-shadow: 0 3px 3px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out;

    &:hover {
      transform: scale(1.02);
    }

    &:active {
      transform: scale(0.99);
    }
  }

  .resultado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .preview {
    width: 220px;
    padding: 0.5rem;
    background-color: #fff;
    border-radius: 8px;
    box-shadow: 0 3px 3px rgba(0, 0, 0, 0.1);

    & :global(svg) {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .buttons-actions {
    display: flex;
    gap: 1rem;
    font-size: small;
  }

  /* Equivalente a .hide del Día 51 */
  .hide {
    display: none;
  }

  @media (max-width: 500px) {
    .box {
      width: 320px;
    }
  }
</style>

<script>
  import QRCode from "qrcode";

  document.addEventListener("astro:page-load", () => {
    const formQR = document.querySelector("#formQR");
    const inputURL = document.querySelector("#inputURL");
    const error = document.querySelector("#error");
    const resultado = document.querySelector("#resultado");
    const preview = document.querySelector("#preview");
    const btnSVG = document.querySelector("#btnSVG");
    const btnPNG = document.querySelector("#btnPNG");

    let svgActual = "";
    let pngActual = "";

    const mostrarError = (mensaje) => {
      //@ts-ignore
      error.innerText = mensaje;
      error.classList.remove("hide");
      resultado.classList.add("hide");
    };

    formQR.addEventListener("submit", async (e) => {
      e.preventDefault();

      const url = inputURL.value.trim();
      if (!url) {
        mostrarError("Ingresa un enlace para generar el QR");
        return;
      }

      const opciones = {
        margin: 2,
        color: {
          dark: "#000000",
          light: "#ffffff",
        },
      };

      try {
        svgActual = await QRCode.toString(url, {
          ...opciones,
          type: "svg",
        });
        pngActual = await QRCode.toDataURL(url, {
          ...opciones,
          width: 1024,
        });

        preview.innerHTML = svgActual;
        error.classList.add("hide");
        resultado.classList.remove("hide");
      } catch (err) {
        mostrarError("No se pudo generar el QR con ese contenido");
      }
    });

    const descargar = (contenido, nombre, tipo) => {
      if (!contenido) return;

      const esDataURL = contenido.startsWith("data:");
      const href = esDataURL
        ? contenido
        : URL.createObjectURL(new Blob([contenido], { type: tipo }));

      const enlace = document.createElement("a");
      enlace.href = href;
      enlace.download = nombre;
      enlace.click();

      if (!esDataURL) URL.revokeObjectURL(href);
    };

    btnSVG.addEventListener("click", () =>
      descargar(svgActual, "qr.svg", "image/svg+xml")
    );

    btnPNG.addEventListener("click", () => descargar(pngActual, "qr.png"));
  });
</script>
